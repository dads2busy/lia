from pydantic_graph import BaseNode,End,GraphRunContext,Graph
from typing import List,Dict,Any,Union
from dataclasses import dataclass,field
from lia.agent import load_agent
from pydantic_ai import Agent
from pydantic import BaseModel,Field
from lia.agent.component_analysis_agent import ComponentAnalysisAgent
import asyncio
import pprint
import json

max_recursion_depth:int = 3

class GenerateSupplyChainNetworkOptions(BaseModel):
    product: str
    debug: bool = False
    model_name: str = "llama3.3"
    llm_api_url: str | None
    llm_api_key: str = ""

@dataclass
class Product:
    name: str
    description: str|None = None
    
@dataclass
class Subcomponent:
    name: str
    parent: str|list[str]|None = None    


autoid = 0

def getAutoId():
    global autoid
    autoid+=1
    return autoid


class Component:
    name: str
    type: str
    complete: bool = False
    parent: 'Component' = None
    depth: int = 0
    id: int = -1
    def __init__(self, name, type='product'):
        self.name = name
        self.type = type
        self._raw_subcomponents = []
        self.subcomponents = None

    def __repr__(self):
         return f"{self.type.capitalize()}({self.name}[{self.id}], {self.subcomponents})"
         
    def add_subcomponent(self,child):
        if self.subcomponents is None:
            self.subcomponents = []
        
        if child.parent is None:
            child.parent = self
            child.depth = self.depth+1
        if child.id==-1:
            child.id=getAutoId()
        self.subcomponents.append(child)
        
    def get_subcomponents(self):
        return self.subcomponents

@dataclass
class GraphState:
    product: Product
    tree: Component
    current: Component|None = None
    systems: list[str]|None = None
    messages:list = field(default_factory = list)
    component_index:dict = field(default_factory = dict)

component_analysis_agent = ComponentAnalysisAgent(result_type=str)

@dataclass
class GetProductSystems(BaseNode[GraphState]):
    async def run(self, ctx: GraphRunContext) -> 'DedupeProductSystems':
        system_prompt = ' '.join([
            "For this analysis we are only intrested in identifying the key systems that make up the product.\n",
            "If the product is simple, it does not need any systems.  You can just return the name of the product as a system in that case.\n",
            "For example, for a food product. We are only interested in the food itself, not the packaging or manufacturing of the food product.\n"
            "Do not include systems that are part of the manufacturing process or packaging process. Only include systems that are part of the deployed product.\n",
            "For example, for a car, systems might be:",
            """
            Engine System
            Fuel System
            Ignition System
            Cooling System
            Exhaust System
            Transmission System
            Drivetrain System
            Suspension System
            Steering System
            Brake System
            Electrical System
            Safety Systems: Encompasses features like airbags, seat belts, and electronic stability controls to protect occupants.
            Infotainment/Communication Systems: Integrates audio, navigation, connectivity, and vehicle interface controls.
            """,
            "It would not include systems such as:\n",
            """
            Design and Engineering Systems
            Enterprise Resource Planning (ERP) Systems
            Manufacturing Execution Systems (MES)
            Supply Chain Management Systems
            Production Planning and Scheduling Systems
            Quality Management Systems (QMS)
            Automation and Robotics Systems
            Material Handling and Logistics Systems
            Maintenance Management Systems
            """,
            "Respond with JSON."
        ])
        agent = ComponentAnalysisAgent(result_type=list[str],system_prompt=system_prompt,retries=5)
        try: 
            for i in range(1):
                r = await agent.run(f"Please generate a list of the key systems that make up '{ctx.state.product.name}'. ",model_settings={'temperature': .5})

                if isinstance(r.data,list):
                    ctx.state.tree._raw_subcomponents  += r.data
        except Exception as err:
            print(f"Error retrieving product systems: {err}")
     
        return DedupeProductSystems()

@dataclass
class DedupeProductSystems(BaseNode[GraphState]):
    async def run(self, ctx: GraphRunContext) -> 'GenerateSupplyChainNetwork':
        system_prompt = ' '.join([
            f"You are an expert in the {ctx.state.product.name} product.\n",
            "Your response should represent the key systems of a product without any duplications or overlapping function.\n",
            "Respond with JSON."
        ])
        

        agent = ComponentAnalysisAgent(result_type=list[str],system_prompt=system_prompt,retries=5)
        subsystems = []
        try: 
            systems_list =  ctx.state.tree._raw_subcomponents
            print(f"systems list: {systems_list}")
            for i in range(1):
                msg = f"""
                    Please deduplicate the '{ctx.state.product.name}' systems:
                     {','.join(systems_list)} 
                     
                     Return the deduplicated list."
                """ 
                r = await agent.run(msg,model_settings={'temperature': .5})

                if isinstance(r.data,list):
                    systems_list = (r.data)
            
            ctx.state.systems = systems_list
            for system in systems_list:
                ctx.state.tree.add_subcomponent(Component(name=system,type="system"))
        except Exception as err:
            print(f"Error deduping product systems: {err}")
     
        return GenerateSupplyChainNetwork()

@dataclass
class ClassifyComponents(BaseNode[GraphState]):
    async def run(self, ctx: GraphRunContext) -> 'GenerateSupplyChainNetwork':
        system_prompt = ' '.join([
            f"You are an expert in the {ctx.state.product.name} product.\n",
            "Distinguish between raw components (elemental materials, basic commodities) and components.\n",
            "Categorize the individual components into one of these categories: 'raw_materials', 'manufacturing_equipment', 'software', or 'components'. 'components' should represent everything not in the prior categories.\n",
            "Raw materials should be considered to items such as: ",
            "elements, chemicals, mined materials, nuts, bolts,lugs, screws,washers,brackets,clamps, metal plates, extrusions,",
            "platics,cables, wires, gaskets,fuses,buttons,labels,clips, connectors, cable management,electrical terminals","containers",
            "simcard", "antenna", "PCB", "printed circuit board","voltage regulator", "thermistor", "photodiode","soldering and welding supplied",
            "Power supply", "mounting hardware", "capacitors","resistors","glass","common circuits","sealants", "wood","glue","adhesives","knobs"
            " and any other commodoties. ",
            "Return an object containing an array for each category.\n",
            "For any elemental raw materials, convert their name to the Element symbol.\n"
            "Respond with JSON.\n"
        ])

        if ctx.state.current.type != "system":
            system_prompt += f"You will be presented with subcomponents of a {ctx.state.current.name}. component.\n"
        else:
            system_prompt += f"You will be presented the subcomponents of the {ctx.state.current.name} subsystem.\n"
        # print(f"dedupe components system promp: {system_prompt}")
    
        prompt = f"""
            Please categorize the list subcomponents.  The list:
                {','.join(ctx.state.current._raw_subcomponents)} 
                
                Return the RawCompOutput object.
        """
        
        class RawCompOutput(BaseModel):
            raw_materials: list[str]
            components: list[str]
            software: list[str]
            manufacturing_equipment: list[str]
        agent = ComponentAnalysisAgent(result_type=RawCompOutput,system_prompt=system_prompt,retries=5)
        try: 
            
            for i in range(1):
                r = await agent.run(prompt,model_settings={'temperature': .5})

                if isinstance(r.data,RawCompOutput):
                    raw_materials= r.data.raw_materials
                    comps = r.data.components
                    software = r.data.software
                    equip = r.data.manufacturing_equipment
                    print(f"CURRENT DEPTH: {ctx.state.current.depth}")
                    if ctx.state.current.depth < max_recursion_depth:
                        to_add = []
                        for subc in comps:
                            to_add.append(Component(name=subc,type="component"))

                        for subc in raw_materials:
                            to_add.append(Component(name=subc,type="raw_material"))
                    
                        for subc in software:
                            to_add.append(Component(name=subc,type="software"))

                        for subc in equip:
                            to_add.append(Component(name=subc,type="manufacturing_equipment"))
 
                        for c in to_add:
                            if c.name in ctx.state.component_index:
                                c = ctx.state.component_index[c.name]
                                
                            ctx.state.current.add_subcomponent(c)
                                
                    else:
                        ctx.state.current.complete = True
                
                    return GenerateSupplyChainNetwork()
        except Exception as err:
            print(f"Error deduping product components: {err}")

@dataclass
class DedupeComponents(BaseNode[GraphState]):
    async def run(self, ctx: GraphRunContext) -> 'ClassifyComponents':
        system_prompt = f"""
            You are an expert in the {ctx.state.product.name} product.
            Your response should deduplicate the provided set of components relative to their parent without any duplications or overlapping function.
            Respond with JSON.
        """

        if ctx.state.current.type != "system":
            system_prompt += f"You will be presented with subcomponents of a {ctx.state.current.name}. component.\n"
        else:
            system_prompt += f"You will be presented the subcomponents of the {ctx.state.current.name} subsystem.\n"
    
        prompt = f"Please deduplicate the following component list:{','.join(ctx.state.current._raw_subcomponents)} \n Return the deduplicated list."
        
        agent = ComponentAnalysisAgent(result_type=list[str],system_prompt=system_prompt,retries=5)
        try: 
            ctx.state.current._raw_subcomponents = []
            for i in range(3):
                r = await agent.run(prompt,model_settings={'temperature': .5})

                if isinstance(r.data,list):
                    ctx.state.current._raw_subcomponents = (r.data)


            def isSameAsParent(comp):
                return comp != ctx.state.current.name
            
            ctx.state.current._raw_subcomponents = list(filter(isSameAsParent,ctx.state.current._raw_subcomponents))
            
            return ClassifyComponents()
        
        except Exception as err:
            print(f"Error deduping product components: {err}")
     

@dataclass
class GetProductDescription(BaseNode[GraphState]):
    async def run(self, ctx: GraphRunContext) -> 'GenerateSupplyChainNetwork':
        print(f"Getting product description for {ctx.state.product.name}")
        result = await component_analysis_agent.run(f"Please provide a short description of the product '{ctx.state.product.name}'.",model_settings={'temperature': .1})
        print(f"Description: {result.data}")
        ctx.state.product.description = result.data
        ctx.state.messages += result.new_messages()
        return GenerateSupplyChainNetwork()
    

@dataclass    
class GetComponents(BaseNode[GraphState]):
    async def run(self, ctx: GraphRunContext) -> Union['DedupeComponents','GenerateSupplyChainNetwork']:
        print(f"Get Components for : {ctx.state.current.name} Parent: {ctx.state.current.parent}")
        
        if ctx.state.current.type=="system":
            prompt = f"Please generate list of the components used to manufacture the {ctx.state.current.name} system of the product.\n"
        elif ctx.state.current.parent is not None:
            prompt = f"Create a list of the components used to manufacture the {ctx.state.current.name} subcomponent of a {ctx.state.current.parent.name} component of the product.\n"
        else:
            print(f"Why don't we have a parent here: {ctx.state.current}")
            raise Exception("Invalid network being setup")
        # print(f"Getting Components: {prompt}")
        system_prompt = ' '.join([
            f"You are an expert in the product '{ctx.state.product.name}'.\n"
            "Component names provided should be the industry standard name for the component."
            "Exclude components that are used for the manufacturing of the component. In other words, only include components of the product itself, not the manufacturing equipment, processes, and materials"
            "Respond with JSON."
        ])

        agent = ComponentAnalysisAgent(result_type=list[str],system_prompt=system_prompt,retries=5)

        try: 
            components=[]
            for i in range(3):
                r = await agent.run(prompt,model_settings={'temperature': .2})

                if isinstance(r.data,list):
                    # print(f"{ctx.state.current.name} Components:")
                    # print(r.data)
                    components += r.data
                      
            ctx.state.current._raw_subcomponents = components
            if (len(components)>0):
                return DedupeComponents()
    
        except Exception as err:
            print(f"Error getting components: {err}")

        return GenerateSupplyChainNetwork()
@dataclass
class GenerateSupplyChainNetwork(BaseNode[GraphState]):
    async def run(self,ctx: GraphRunContext) -> GetProductSystems | GetComponents | End[GraphState]:
        # get the product descriptions
        if ctx.state.product.description is None:
            return GetProductDescription()
        
        # generate a list of key systems of the product
        if ctx.state.systems is None:
            return GetProductSystems()

        if ctx.state.current is None:
            ctx.state.current = ctx.state.tree        

        def find_next(node):
            if node.complete or node.type=="raw_material" or node.type=="software" or node.type=="manufacturing_equipment":
                return None
            
            out_next = None
            if node.subcomponents is None:
                return node
            
            for child in node.subcomponents:
                next = find_next(child)
                if next is not None:
                    out_next = next
                    break
        
            return out_next
        
        nxt = find_next(ctx.state.current)
        if nxt is None:
            ctx.state.current = find_next(ctx.state.tree)
        else:
            ctx.state.current = nxt   
            
        if ctx.state.current is not None:
            return GetComponents()
        
        response = {
            "product": ctx.state.product,
            "systems": ctx.state.systems,
            "tree": ctx.state.tree,
            "list": ctx.state.component_index
        }
        
        return End(response)

def serialize_component_tree(root):
    nodes = []
    links = []

    def traverse(component):
        # Add the current component as a node
        nodes.append({
            "id": component.id,
            "name": component.name,
            "type": component.type,
        })
        # If the component has subcomponents, create links and traverse them
        if component.subcomponents:
            for child in component.subcomponents:
                links.append({
                    "source": component.id,
                    "target": child.id
                })
                traverse(child)

    traverse(root)
    network = {"nodes": nodes, "edges": links}
    return json.dumps(network, indent=4)

TaskGraph = Graph(nodes=(GenerateSupplyChainNetwork,GetProductDescription,GetProductSystems,DedupeProductSystems,GetComponents,DedupeComponents,ClassifyComponents))

async def analyze_product(product:str,options):
    pass


async def main():
    product = Product(
        name='Apple M1 Microprocessor'
    )
    state = GraphState(product=product,tree=Component(name=product.name))
    print(f"Analyzing {product}")
    # print(f"Initial State: {state}")
    # TaskGraph.mermaid_save("SupplyChainMermaid.png")
    # print(f"Graph: {TaskGraph}")
    result= await TaskGraph.run(GenerateSupplyChainNetwork(),state=state)
    print("Graph Run Complete.")
    pprint.pp(result[-1][-1].result.data["tree"],indent=4)

    with open(f"{product.name}_network.json", 'w') as f:
        f.write(serialize_component_tree(result[-1][-1].result.data["tree"]))
        f.close()
            
if __name__ == "__main__":
    loop = asyncio.get_event_loop()
    loop.run_until_complete(main())